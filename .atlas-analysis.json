  "projectDescription": "A scripting platform for Roblox developers to write, host, and execute Lua scripts via loadstring URLs.",
  "theme": "luma",
  "primaryColor": "#ef7025",
  "lightColor": "#eec9bc",
  "darkColor": "#4fa1ab",

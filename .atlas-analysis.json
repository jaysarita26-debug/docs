              "api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api/scripts",
              "api/loadstring",
              "api/versions"
            ]
          }
        ]
      }
    ]
  },
  "keyFeatures": [
    "Host Lua scripts accessible via a public loadstring URL",
    "Version control for scripts with rollback support",
    "Access control and permission management per script",
    "Instant script execution in Roblox via loadstring(game:HttpGet(url))()",
    "Script management dashboard",
    "REST API for programmatic script management"
  ],
  "publicApiSurface": [
    "GET /api/scripts — list all scripts",
    "POST /api/scripts — create a new script",
    "GET /api/scripts/:id — retrieve a script",
    "PUT /api/scripts/:id — update a script",
    "DELETE /api/scripts/:id — delete a script",
    "GET /api/scripts/:id/versions — list script versions",
    "GET /loadstring/:id — serve raw Lua script for loadstring execution",
    "POST /api/auth/token — obtain an API token"
  ]
}
